---
/**
 * M3 Top App Bar — 全站顶栏（Firefly-inspired 清爽高对比半透明毛玻璃导航栏）
 */
import IconButton from "@components/atoms/action/IconButton.svelte";
import { resolveNavBarLinks, resolvePageKey } from "@utils/nav-utils";
import { url } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { profileConfig, siteConfig } from "@/config";
import { navBarConfig } from "@/config/navBarConfig";
import { resolveAsset } from "@utils/asset-utils";
import DisplaySettings from "./DisplaySettings.svelte";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import Search from "./Search.svelte";

const className = Astro.props.class;
const links = resolveNavBarLinks(navBarConfig.links);
const currentPageKey = resolvePageKey(Astro.url);
const avatarAsset = profileConfig.avatar
	? await resolveAsset(profileConfig.avatar)
	: null;

function hrefFor(path?: string) {
	return path ? url(path) : undefined;
}

function isActive(link: (typeof links)[number]): boolean {
	return Boolean(
		(link.pageKey && link.pageKey === currentPageKey) ||
			link.children?.some(isActive),
	);
}
---

<div
	id="navbar"
	class:list={[
		"top-app-bar fixed top-0 left-0 right-0 z-50 transition",
		className,
	]}
>
	<script is:inline>
		(function () {
			const scrollTop = window.scrollY || document.documentElement.scrollTop || 0;
			if (scrollTop > 64) {
				document.body.dataset.bannerScrolled = "true";
				const nb = document.getElementById("navbar");
				if (nb) {
					nb.classList.remove("top-app-bar--transparent");
					nb.classList.add("top-app-bar--scrolled");
				}
			}
		})();
	</script>
	<div class="relative max-w-[var(--page-width)] mx-auto h-16 px-3 md:px-5 flex items-center gap-1.5">
		<IconButton id="nav-drawer-switch" label="Menu" class="shrink-0 lg:!hidden">
			<Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
		</IconButton>
		<a
			href={url("/")}
			class="header-brand group flex h-10 items-center gap-2.5 px-2 text-[var(--on-surface)] transition whitespace-nowrap"
			aria-label={siteConfig.title}
		>
			{avatarAsset && (
				<img
					src={avatarAsset}
					alt=""
					aria-hidden="true"
					class="header-avatar w-7 h-7 rounded-full object-cover ring-1 ring-black/10 dark:ring-white/20 transition-transform duration-300 group-hover:scale-105"
					loading="eager"
					fetchpriority="high"
				/>
			)}
			<span class="header-title text-[1.125rem] font-semibold tracking-tight transition-colors group-hover:text-[var(--primary)]">{siteConfig.title}</span>
		</a>
		<nav class:list={["top-app-bar__nav hidden h-full items-center gap-1 lg:flex", siteConfig.topAppBar.contentAlign === "center" ? "lg:absolute lg:left-1/2 lg:-translate-x-1/2" : "ml-4"]} aria-label="Main navigation">
			{links.map((link) => {
				const href = link.external ? link.url : hrefFor(link.url);
				const active = isActive(link);
				return (
					<div class="top-app-bar__nav-group" data-nav-group>
						{link.children ? (
							<button class:list={[
								"top-app-bar__nav-link relative flex h-9 items-center gap-1.5 px-3 text-sm font-medium transition-colors",
								active && "top-app-bar__nav-link--active",
							]} aria-expanded="false">
								{link.icon && <Icon name={link.icon} class="text-[1.1rem] opacity-80"></Icon>}
								<span>{link.name}</span>
								<Icon name="material-symbols:keyboard-arrow-down-rounded" class="text-[1rem] opacity-60"></Icon>
							</button>
						) : (
							<a href={href} target={link.external ? "_blank" : undefined} rel={link.external ? "noopener noreferrer" : undefined}
								aria-current={active ? "page" : undefined} data-nav-key={link.pageKey ?? ""}
								class:list={[
									"top-app-bar__nav-link relative flex h-9 items-center gap-1.5 px-3 text-sm font-medium transition-colors",
									active && "top-app-bar__nav-link--active"
								]}>
								{link.icon && <Icon name={link.icon} class="text-[1.1rem] opacity-80"></Icon>}
								<span>{link.name}</span>
								{link.external && <Icon name="material-symbols:arrow-outward-rounded" class="ml-0.5 text-[0.875rem] opacity-60"></Icon>}
							</a>
						)}
						{link.children && <div class="top-app-bar__submenu" role="menu">
							{link.children.map((child) => {
								const childHref = child.external ? child.url : hrefFor(child.url);
								return <a href={childHref} target={child.external ? "_blank" : undefined} rel={child.external ? "noopener noreferrer" : undefined} role="menuitem" data-nav-key={child.pageKey ?? ""} class="top-app-bar__submenu-item">
									{child.icon && <Icon name={child.icon} class="text-[1.15rem] opacity-75"></Icon>}
									<span>{child.name}</span>
									{child.external && <Icon name="material-symbols:arrow-outward-rounded" class="ml-auto text-[0.875rem] opacity-60"></Icon>}
								</a>;
							})}
						</div>}
					</div>
				);
			})}
		</nav>
		<div class="flex-1"></div>
		<div class="flex items-center gap-1">
			<Search client:only="svelte"></Search>
			{!siteConfig.themeColor.fixed && (
				<IconButton id="display-settings-switch" label="Display Settings" class="shrink-0">
					<Icon name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
				</IconButton>
			)}
			<LightDarkSwitch client:only="svelte"></LightDarkSwitch>
		</div>
		<DisplaySettings client:only="svelte" class="top-full right-4 max-w-[calc(100vw-2rem)] md:right-0"></DisplaySettings>
	</div>
</div>

<script>
	import { resolvePageKey } from "@utils/nav-utils";

	function syncTopAppBarNavigation() {
		setTopAppBarNavigation(resolvePageKey(new URL(window.location.href)));
	}

	function setTopAppBarNavigation(pageKey: string) {
		document.querySelectorAll<HTMLElement>("[data-nav-key]").forEach((link) => {
			const active = (link.dataset.navKey || "") === pageKey;
			link.classList.toggle("top-app-bar__nav-link--active", active);
			if (active) link.setAttribute("aria-current", "page");
			else link.removeAttribute("aria-current");
		});
		document.querySelectorAll<HTMLElement>("[data-nav-group]").forEach((group) => {
			// 仅处理有下拉子菜单的组（组触发器是 button）；普通链接组已由上面设置
			const trigger = group.querySelector(":scope > button.top-app-bar__nav-link");
			if (!trigger) return;
			const active = Boolean(group.querySelector(".top-app-bar__submenu-item.top-app-bar__nav-link--active"));
			trigger.classList.toggle("top-app-bar__nav-link--active", active);
		});
	}

	function closeTopAppBarMenus() {
		document.querySelectorAll<HTMLElement>("[data-nav-group].top-app-bar__nav-group--open").forEach((group) => {
			group.classList.remove("top-app-bar__nav-group--open");
			group.querySelector(":scope > button")?.setAttribute("aria-expanded", "false");
		});
	}

	function loadTopAppBar() {
		const drawerBtn = document.getElementById("nav-drawer-switch");
		if (drawerBtn) {
			drawerBtn.onclick = () => {
				document.dispatchEvent(new CustomEvent("site-drawer:toggle"));
			};
		}

		const settingBtn = document.getElementById("display-settings-switch");
		if (settingBtn) {
			settingBtn.onclick = () => {
				const settingPanel = document.getElementById("display-setting");
				if (settingPanel) {
					settingPanel.classList.toggle("float-panel-closed");
				}
			};
		}

		syncTopAppBarNavigation();
		document.querySelectorAll<HTMLElement>("[data-nav-key]").forEach((link) => {
			link.onclick = () => {
				setTopAppBarNavigation(link.dataset.navKey || "");
				closeTopAppBarMenus();
			};
		});
		document.querySelectorAll<HTMLElement>("[data-nav-group]").forEach((group) => {
			const trigger = group.querySelector<HTMLButtonElement>(":scope > button");
			if (!trigger) return;
			trigger.onclick = () => {
				const open = group.classList.toggle("top-app-bar__nav-group--open");
				trigger.setAttribute("aria-expanded", String(open));
			};
		});
		if (!document.documentElement.dataset.topAppBarNavBound) {
			document.documentElement.dataset.topAppBarNavBound = "true";
			document.addEventListener("swup:content:replace", syncTopAppBarNavigation);
			document.addEventListener("swup:page:view", syncTopAppBarNavigation);
			document.addEventListener("click", (event) => {
				const insideNavigationGroup = event.composedPath().some(
					(node) => node instanceof HTMLElement && node.hasAttribute("data-nav-group"),
				);
				if (!insideNavigationGroup) {
					closeTopAppBarMenus();
				}
			});
			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape") closeTopAppBarMenus();
			});
			window.addEventListener("popstate", syncTopAppBarNavigation);
		}
	}

	loadTopAppBar();
</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
window.__loadPagefind = function() {
	if (window.__pagefindLoadingPromise) return window.__pagefindLoadingPromise;
	window.__pagefindLoadingPromise = (async () => {
		try {
			const pagefind = await import(scriptUrl);
			await pagefind.options({
				excerptLength: 20
			});
			window.pagefind = pagefind;
			document.dispatchEvent(new CustomEvent('pagefindready'));
			return pagefind;
		} catch (error) {
			console.error('Failed to load Pagefind:', error);
			window.pagefind = {
				search: () => Promise.resolve({ results: [] }),
				options: () => Promise.resolve(),
			};
			document.dispatchEvent(new CustomEvent('pagefindloaderror'));
			return window.pagefind;
		}
	})();
	return window.__pagefindLoadingPromise;
};

function bindSearchTriggers() {
	const triggers = [
		document.getElementById('search-input-desktop'),
		document.getElementById('search-switch')
	];
	for (const el of triggers) {
		if (!el) continue;
		if (el.dataset.pagefindBound === 'true') continue;
		el.dataset.pagefindBound = 'true';
		el.addEventListener('focus', window.__loadPagefind, { once: true, passive: true });
		el.addEventListener('click', window.__loadPagefind, { once: true, passive: true });
	}
}

if (document.readyState === 'loading') {
	document.addEventListener('DOMContentLoaded', bindSearchTriggers, { once: true });
} else {
	bindSearchTriggers();
}
document.addEventListener('swup:content:replace', bindSearchTriggers);
</script>}

<style>
	.top-app-bar {
		background: rgba(255, 255, 255, 0.8);
		backdrop-filter: blur(20px) saturate(180%);
		-webkit-backdrop-filter: blur(20px) saturate(180%);
		border-bottom: 1px solid rgba(0, 0, 0, 0.06);
		box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.04);
		color: var(--on-surface);
		transition:
			background-color 0.3s cubic-bezier(0.2, 0, 0, 1),
			border-color 0.3s cubic-bezier(0.2, 0, 0, 1),
			box-shadow 0.3s cubic-bezier(0.2, 0, 0, 1),
			color 0.2s cubic-bezier(0.2, 0, 0, 1);
	}

	:global(.dark) .top-app-bar {
		background: rgba(18, 18, 22, 0.8);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.35);
	}

	.top-app-bar--scrolled {
		box-shadow: 0 6px 24px -2px rgba(0, 0, 0, 0.07);
	}
	:global(.dark) .top-app-bar--scrolled {
		box-shadow: 0 6px 24px -2px rgba(0, 0, 0, 0.45);
	}

	/* Declarative Transparent State over Banner before/during/after JS execution */
	@media (min-width: 1024px) {
		:global(html[data-wallpaper-mode="banner"] body[data-banner-has-desktop="true"]:not([data-banner-scrolled="true"])) #navbar {
			background: transparent;
			border-bottom-color: transparent;
			box-shadow: none;
			backdrop-filter: none;
			-webkit-backdrop-filter: none;
			color: white;
			--on-surface: white;
			--on-surface-variant: rgba(255, 255, 255, 0.88);
			--primary: white;
		}
	}

	@media (max-width: 1023.98px) {
		:global(html[data-wallpaper-mode="banner"] body[data-current-page="home"][data-banner-has-mobile="true"]:not([data-banner-scrolled="true"])) #navbar {
			background: transparent;
			border-bottom-color: transparent;
			box-shadow: none;
			backdrop-filter: none;
			-webkit-backdrop-filter: none;
			color: white;
			--on-surface: white;
			--on-surface-variant: rgba(255, 255, 255, 0.88);
			--primary: white;
		}
	}

	.top-app-bar--transparent {
		background: transparent;
		border-bottom-color: transparent;
		box-shadow: none;
		backdrop-filter: none;
		-webkit-backdrop-filter: none;
		color: white;
		--on-surface: white;
		--on-surface-variant: rgba(255, 255, 255, 0.88);
		--primary: white;
	}

	/* Submenu and floating surfaces keep their original theme colors */
	:global(#navbar .float-panel),
	:global(#navbar .m3-menu),
	:global(#navbar .top-app-bar__submenu) {
		--on-surface: var(--mc-on-surface);
		--on-surface-variant: var(--mc-on-surface-variant);
		--primary: var(--mc-primary);
		color: var(--mc-on-surface);
	}

	:global(.top-app-bar--transparent .top-app-bar__search-shell--expanded),
	:global(html[data-wallpaper-mode="banner"] body:not([data-banner-scrolled="true"]) #navbar .top-app-bar__search-shell--expanded) {
		--on-surface: var(--mc-on-surface);
		--on-surface-variant: var(--mc-on-surface-variant);
		--primary: var(--mc-primary);
		color: var(--mc-on-surface);
	}

	/* !important boundary: User input caret and color in expanded search shell to override browser defaults */
	:global(#navbar .top-app-bar__search-shell--expanded input) {
		color: var(--mc-on-surface) !important;
		caret-color: var(--mc-primary) !important;
	}

	/* !important boundary: Search icon color in expanded search shell to override browser defaults */
	:global(#navbar .top-app-bar__search-shell--expanded svg) {
		color: var(--mc-on-surface-variant) !important;
	}

	/* Clean navigation link styles */
	.top-app-bar__nav-link {
		border-radius: 0.5rem;
		color: var(--on-surface-variant);
		transition: color 0.15s ease, background-color 0.15s ease;
	}

	.top-app-bar__nav-link:hover {
		color: var(--on-surface);
		background-color: color-mix(in oklab, var(--on-surface) 6%, transparent);
	}

	.top-app-bar__nav-link--active {
		color: var(--primary);
		background-color: color-mix(in oklab, var(--primary) 10%, transparent);
		font-weight: 600;
	}

	/* Transparent mode links */
	:global(.top-app-bar--transparent) .top-app-bar__nav-link,
	@media (min-width: 1024px) {
		:global(html[data-wallpaper-mode="banner"] body[data-banner-has-desktop="true"]:not([data-banner-scrolled="true"])) .top-app-bar__nav-link {
			color: rgba(255, 255, 255, 0.88);
		}
		:global(html[data-wallpaper-mode="banner"] body[data-banner-has-desktop="true"]:not([data-banner-scrolled="true"])) .top-app-bar__nav-link:hover {
			color: white;
			background-color: rgba(255, 255, 255, 0.16);
		}
		:global(html[data-wallpaper-mode="banner"] body[data-banner-has-desktop="true"]:not([data-banner-scrolled="true"])) .top-app-bar__nav-link--active {
			color: white;
			background-color: rgba(255, 255, 255, 0.24);
		}
	}

	.top-app-bar--transparent .top-app-bar__nav-link {
		color: rgba(255, 255, 255, 0.88);
	}
	.top-app-bar--transparent .top-app-bar__nav-link:hover {
		color: white;
		background-color: rgba(255, 255, 255, 0.16);
	}
	.top-app-bar--transparent .top-app-bar__nav-link--active {
		color: white;
		background-color: rgba(255, 255, 255, 0.24);
	}

	/* Submenu */
	.top-app-bar__nav-group {
		position: relative;
	}

	.top-app-bar__submenu {
		position: absolute;
		top: calc(100% + 0.375rem);
		left: 0;
		min-width: 11.5rem;
		padding: 0.375rem;
		border-radius: 0.75rem;
		background: rgba(255, 255, 255, 0.88);
		backdrop-filter: blur(20px) saturate(180%);
		-webkit-backdrop-filter: blur(20px) saturate(180%);
		border: 1px solid rgba(0, 0, 0, 0.06);
		box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08), 0 8px 10px -6px rgba(0, 0, 0, 0.04);
		opacity: 0;
		visibility: hidden;
		transform: translateY(-0.25rem) scale(0.97);
		transform-origin: top left;
		transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s ease;
	}

	:global(.dark) .top-app-bar__submenu {
		background: rgba(24, 24, 28, 0.88);
		border: 1px solid rgba(255, 255, 255, 0.08);
		box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4), 0 8px 10px -6px rgba(0, 0, 0, 0.2);
	}

	.top-app-bar__nav-group:hover > .top-app-bar__submenu,
	.top-app-bar__nav-group:focus-within > .top-app-bar__submenu,
	.top-app-bar__nav-group--open > .top-app-bar__submenu {
		opacity: 1;
		visibility: visible;
		transform: translateY(0) scale(1);
	}

	.top-app-bar__submenu-item {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		min-height: 2.375rem;
		padding: 0 0.75rem;
		border-radius: 0.5rem;
		color: var(--on-surface);
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: none;
		transition: background-color 0.15s ease, color 0.15s ease;
	}

	.top-app-bar__submenu-item:hover,
	.top-app-bar__submenu-item:focus-visible {
		background: color-mix(in oklab, var(--primary) 8%, transparent);
		color: var(--primary);
		outline: none;
	}

	.top-app-bar__submenu-item.top-app-bar__nav-link--active {
		background: color-mix(in oklab, var(--primary) 12%, transparent);
		color: var(--primary);
		font-weight: 600;
	}
</style>
